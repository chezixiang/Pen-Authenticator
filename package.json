{
  "name": "dictpen-authenticator",
  "version": "0.1.0",
  "description": "2FA验证器：有道词典笔两步验证器（TOTP/HOTP，多账号，扫码/手动导入）",
  "appName": "2FA验证器",
  "appid": "8002026102300011",
  "icon": "2FA.png",
  "quickjs": {
    "version": "20200705",
    "bigNum": false
  },
  "single-js-bundle": false,
  "scripts": {
    "start": "npx -y node@18 node_modules/aiot-vue-cli/src/cli.js preview",
    "postinstall": "node scripts/patch-cli.cjs",
    "build": "npx -y node@18 node_modules/aiot-vue-cli/src/cli.js -p",
    "build:prod": "npx -y node@18 node_modules/aiot-vue-cli/src/cli.js -c -q -p",
    "build:dev": "npx -y node@18 node_modules/aiot-vue-cli/src/cli.js",
    "build:web": "npx -y node@18 scripts/build-web.cjs",
    "build:simulator": "npx -y node@18 node_modules/aiot-vue-cli/src/cli.js simulator ./",
    "upload": "npx -y node@18 node_modules/aiot-vue-cli/src/cli.js upload -n",
    "check": "npx -y node@18 node_modules/aiot-vue-cli/src/cli.js check"
  },
  "dependencies": {
    "@dictpen/core": "file:./packages/core",
    "falcon-ui": "^2.0.2"
  },
  "devDependencies": {
    "@dictpen/types": "file:./packages/types",
    "@rollup/plugin-typescript": "^12.1.3",
    "@vue/compiler-sfc": "^3.5.17",
    "aiot-vue-cli": "^1.0.32",
    "typescript": "^5.6.0",
    "vue": "^3.5.17"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "iot",
    "miniapp",
    "youdao",
    "dictpen"
  ],
  "nativeModuleAliases": {
    "am": "$am"
  }
}
